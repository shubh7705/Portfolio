# Recommended for Cloud Deployments (Render Free Tier blocks raw SMTP ports)
# Get a free API key at: https://resend.com
RESEND_API_KEY=your_resend_api_key

# Optional: Gmail SMTP credentials (works locally; blocked on Render Free tier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Where contact form emails are delivered
RECEIVER_EMAIL=shubhamjadhav7705@gmail.com

# Allowed CORS origin(s), comma-separated
FRONTEND_ORIGIN=http://localhost:5173

